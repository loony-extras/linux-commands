# /etc/audit/rules.d/99-custom.rules — loony-linux
# Production auditd ruleset (aligned with CIS Benchmark)
# Apply: augenrules --load && systemctl restart auditd

# =========================================================================
# Reset
# =========================================================================
-D

# Buffer size (increase if getting "backlog limit exceeded" in dmesg)
-b 8192

# Failure mode: 1=printk (don't panic), 2=kernel panic (high security)
-f 1

# =========================================================================
# FILTERS — reduce noise from high-frequency, low-risk actions
# =========================================================================

# Ignore failed file stat calls (very noisy, minimal value)
-a always,exit -F arch=b64 -S open -F exit=-ENOENT -F auid!=4294967295 -k filenotfound
-a always,exit -F arch=b32 -S open -F exit=-ENOENT -F auid!=4294967295 -k filenotfound

# Filter noisy audit calls from known safe daemons
-a never,user -F subj_type=crond_t
-a never,exit -F arch=b64 -S open -F path=/proc/self/loginuid -F exit=-EPERM

# =========================================================================
# IDENTITY AND AUTHENTICATION
# =========================================================================
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# PAM configuration changes
-w /etc/pam.d/ -p wa -k pam

# Login definitions
-w /etc/login.defs -p wa -k login
-w /etc/securetty -p wa -k login

# =========================================================================
# PRIVILEGE ESCALATION
# =========================================================================
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

# Privileged command execution (setuid/setgid)
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k setuid_exec
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k setuid_exec
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k setgid_exec
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k setgid_exec

# Specific privileged binaries
-w /usr/bin/sudo -p x -k sudo
-w /usr/bin/su -p x -k su
-w /usr/bin/newgrp -p x -k newgrp

# =========================================================================
# SESSION TRACKING
# =========================================================================
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session
-w /var/run/utmp -p wa -k session

# =========================================================================
# SYSTEM CALLS — privilege and kernel manipulation
# =========================================================================

# Process injection attempts
-a always,exit -F arch=b64 -S ptrace -k ptrace_call
-a always,exit -F arch=b32 -S ptrace -k ptrace_call

# Kernel module loading/unloading
-a always,exit -F arch=b64 -S init_module -k module_load
-a always,exit -F arch=b64 -S delete_module -k module_unload
-w /sbin/insmod -p x -k module_tools
-w /sbin/rmmod -p x -k module_tools
-w /sbin/modprobe -p x -k module_tools

# Mounting (can be used to bypass controls)
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=4294967295 -k mount
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=4294967295 -k mount

# chmod/chown — privilege changes on files
-a always,exit -F arch=b64 -S chmod -S fchmod -S fchmodat -F auid>=1000 -k chmod
-a always,exit -F arch=b64 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -k chown
-a always,exit -F arch=b64 -S setxattr -S lsetxattr -S fsetxattr -F auid>=1000 -k xattr

# setuid syscall (capability elevation)
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -k setuid_call

# =========================================================================
# NETWORK CONFIGURATION
# =========================================================================
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_config
-w /etc/hosts -p wa -k network_config
-w /etc/network/ -p wa -k network_config
-w /etc/netplan/ -p wa -k network_config
-w /etc/resolv.conf -p wa -k network_config

# =========================================================================
# FILE INTEGRITY — critical system files
# =========================================================================
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config

# Cron
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron

# System binaries — detect binary replacement attacks
-w /usr/bin/ -p wa -k binary_modified
-w /usr/sbin/ -p wa -k binary_modified
-w /usr/local/bin/ -p wa -k binary_modified
-w /bin/ -p wa -k binary_modified
-w /sbin/ -p wa -k binary_modified

# =========================================================================
# MAKE RULES IMMUTABLE
# =========================================================================
# This MUST be the last line. Requires reboot to change rules after this.
# Comment out during initial setup/debugging, uncomment for production.
-e 2
