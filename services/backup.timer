[Unit]
Description=Daily Backup Timer

[Timer]
# Run at 2 AM daily
OnCalendar=*-*-* 02:00:00
# Randomize by up to 30 minutes (avoid simultaneous backups on multiple servers)
RandomizedDelaySec=1800
# Run immediately if the system was off during the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
